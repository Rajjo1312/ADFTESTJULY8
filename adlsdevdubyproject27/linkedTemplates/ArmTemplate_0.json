			"name": "[concat(parameters('factoryName'), '/DS_BinaryTXT')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_BinaryTXT",
					"type": "LinkedServiceReference"
