		{
			"name": "[concat(parameters('factoryName'), '/LS_PARENT_SQLSERVER PARENT')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Onprem server parent",
				"annotations": [],
				"type": "SqlServer",
				"typeProperties": {
					"server": "[parameters('LS_PARENT_SQLSERVER PARENT_properties_typeProperties_server')]",
					"database": "[parameters('LS_PARENT_SQLSERVER PARENT_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_PARENT_SQLSERVER PARENT_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_PARENT_SQLSERVER PARENT_password')]"
					}
				},
				"connectVia": {
